# Shared build settings. Every variant of a profile uses the same configure
# flags so that benchmark differences come only from patches or compiler mode.

# Build profiles (QHT_PROFILE):
#   minimal  CLI + a few extensions; used for engine benchmarks (default)
#   full     CLI + PHP-FPM + the extensions PHP apps usually need (Composer,
#            Laravel, WordPress, aaPanel sites). Used by both runtime modes:
#            QHturbo Compatible (FPM) and QHturbo Performance (workers).
if [[ "${QHT_PROFILE:-minimal}" == full ]]; then
  # Install prefix lives beside, never on top of, the distro/aaPanel PHP.
  QHT_PREFIX="${QHT_PREFIX:-/opt/qhturbo/${QHT_PHP:-8.5}}"
  CONFIGURE_FLAGS=(
    --prefix="$QHT_PREFIX"
    --with-config-file-path="$QHT_PREFIX/etc"
    --with-config-file-scan-dir="$QHT_PREFIX/etc/conf.d"
    --enable-cli --enable-fpm --disable-cgi --disable-phpdbg
    --with-zlib --with-curl --with-zip --with-sodium --with-gmp --with-readline
    --enable-mbstring --enable-intl --enable-bcmath --enable-calendar
    --enable-exif --enable-sockets --enable-pcntl --enable-soap
    --enable-gd --with-jpeg --with-freetype
    --with-mysqli=mysqlnd --with-pdo-mysql=mysqlnd --with-pdo-sqlite --with-sqlite3
    --enable-shmop --enable-sysvsem --enable-sysvshm --enable-ftp --with-gettext
  )
  # OPcache is built in since 8.5; before that it is a shared extension.
  if [[ "${QHT_PHP:-}" != 8.5 ]]; then
    CONFIGURE_FLAGS+=(--enable-opcache)
  fi
  # PHP < 8.1 cannot build against OpenSSL 3 (Ubuntu 22.04+); use a private
  # OpenSSL 1.1.1 built by scripts/deps-openssl11.sh when present.
  # xmlrpc was bundled until 7.4 (PECL only since 8.0); aaPanel's 7.4 has it.
  if [[ "${QHT_PHP:-}" == 7.* ]]; then
    CONFIGURE_FLAGS+=(--with-xmlrpc)
  fi
  if [[ "${QHT_PHP:-}" == 7.* || "${QHT_PHP:-}" == 8.0 ]]; then
    if [[ -d "${QHT_LAB:-}/deps/openssl-1.1" ]]; then
      CONFIGURE_FLAGS+=(--with-openssl)
      export PKG_CONFIG_PATH="$QHT_LAB/deps/openssl-1.1/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
      QHT_EXTRA_LDFLAGS="-Wl,-rpath,$QHT_LAB/deps/openssl-1.1/lib"
    fi
  else
    CONFIGURE_FLAGS+=(--with-openssl)
  fi
else
  # Minimal CLI build. OPcache is always compiled in since PHP 8.5.
  CONFIGURE_FLAGS=(
    --disable-all
    --enable-cli
    --disable-cgi
    --disable-phpdbg
    --enable-ctype
    --enable-tokenizer
    --enable-filter
    --enable-mbstring --disable-mbregex
    --enable-opcache
  )
  # JSON is a core extension only since PHP 8.0; 7.4 needs it enabled explicitly.
  if [[ "${QHT_PHP:-}" == 7.* ]]; then
    CONFIGURE_FLAGS+=(--enable-json)
  fi
fi

# Same base optimisation level for all variants.
BASE_CFLAGS="-O2 -g"

# Extra flags for the qhturbo-pgo variant (PGO itself is driven by build.sh).
# LTO is deliberately NOT used: with GCC it breaks the Zend VM's global
# register variables ("global register variable follows a function
# definition" in zend_jit_vm_helpers.c), and disabling those registers costs
# more than LTO gains. See logs/issues.md (ISSUE-001).
PGO_EXTRA_CFLAGS=""
PGO_EXTRA_LDFLAGS=""
