# Shared build settings. Every variant uses the same configure flags so that
# benchmark differences come only from the source patches or compiler mode.

# Minimal CLI build. OPcache is always compiled in since PHP 8.5.
CONFIGURE_FLAGS=(
  --disable-all
  --enable-cli
  --disable-cgi
  --disable-phpdbg
  --enable-ctype
  --enable-tokenizer
  --enable-filter
  --enable-mbstring --disable-mbregex
  --enable-opcache
)
# JSON is a core extension only since PHP 8.0; 7.4 needs it enabled explicitly.
if [[ "${QHT_PHP:-}" == 7.* ]]; then
  CONFIGURE_FLAGS+=(--enable-json)
fi

# Same base optimisation level for all variants.
BASE_CFLAGS="-O2 -g"

# Extra flags for the qhturbo-pgo variant (PGO itself is driven by build.sh).
# LTO is deliberately NOT used: with GCC it breaks the Zend VM's global
# register variables ("global register variable follows a function
# definition" in zend_jit_vm_helpers.c), and disabling those registers costs
# more than LTO gains. See logs/issues.md (ISSUE-001).
PGO_EXTRA_CFLAGS=""
PGO_EXTRA_LDFLAGS=""
