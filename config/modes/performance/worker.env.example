# /etc/qhturbo/worker-<name>.env for qhturbo-worker@<name>.service
QHT_APP=/var/www/myapp/worker.php
QHT_HOST=127.0.0.1
QHT_PORT=8080
# Processes: about one per CPU core.
QHT_WORKERS=4
# Requests in flight per worker: 1 = sequential (safe for any code).
# >1 only if the app keeps request state in the Request object (see docs).
QHT_CONCURRENCY=1
QHT_MAX_REQUESTS=10000
QHT_MEMORY_LIMIT=256M
# e.g. --superglobals for legacy code, --strict-state on staging
QHT_EXTRA_ARGS=
